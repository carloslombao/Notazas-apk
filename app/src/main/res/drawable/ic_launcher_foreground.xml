<?xml version="1.0" encoding="utf-8"?>
<!-- Primeiro plano da icona de Notazas: un libro (o 📘 da web) en vector. Todo o contido cabe na
     zona segura da icona adaptativa (círculo de 66dp no centro dos 108dp), así que non se recorta
     con ningunha máscara (círculo, escuadra, "squircle"...). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bloque de follas (asoma pola dereita e por abaixo) -->
    <path
        android:fillColor="#FFD1FAE5"
        android:pathData="M36,28 h34 a4,4 0 0 1 4,4 v44 a4,4 0 0 1 -4,4 h-34 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- Capa -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,26 h32 a4,4 0 0 1 4,4 v44 a4,4 0 0 1 -4,4 h-32 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- Lombo -->
    <path
        android:fillColor="#FF10B981"
        android:pathData="M36,26 h6 v52 h-6 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- Liñas de texto na capa -->
    <path
        android:fillColor="#FF10B981"
        android:pathData="M48,38 h18 v3 h-18 z M48,46 h18 v3 h-18 z M48,54 h12 v3 h-12 z" />

    <!-- Marcapáxinas -->
    <path
        android:fillColor="#FFF59E0B"
        android:pathData="M60,26 h8 v16 l-4,-4 l-4,4 z" />
</vector>
